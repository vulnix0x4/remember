{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remember-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOW_DEV_AUTH": "true",
    "AUTH_MODE": "token",
    "DEFAULT_USER_ID": "00000000-0000-4000-8000-000000000001",
    "ANALYSIS_PROVIDER": "mock",
    "PROCESSING_MODE": "workflow",
    "OPENROUTER_MODEL": "stealth/ox-alpha",
    "OPENROUTER_SITE_URL": "http://localhost:5173",
    "ACCESS_TEAM_DOMAIN": "https://local.cloudflareaccess.com",
    "ACCESS_AUD": "local-development",
    "CORS_ORIGIN": "http://localhost:5173"
  },
  "secrets": {
    "required": ["AUTH_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remember-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "remember-media"
    }
  ],
  "ai": { "binding": "AI" },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "remember-imprints"
    }
  ],
  "workflows": [
    {
      "binding": "INGESTION_WORKFLOW",
      "name": "remember-ingestion",
      "class_name": "IngestionWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 15 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "production": {
      "name": "remember-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "remember.example.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health", "/contract"]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOW_DEV_AUTH": "false",
        "AUTH_MODE": "password",
        "DEFAULT_USER_ID": "00000000-0000-4000-8000-000000000001",
        "ANALYSIS_PROVIDER": "openrouter",
        "PROCESSING_MODE": "workflow",
        "OPENROUTER_MODEL": "stealth/ox-alpha",
        "OPENROUTER_SITE_URL": "https://remember.example.com",
        "ACCESS_TEAM_DOMAIN": "https://local.cloudflareaccess.com",
        "ACCESS_AUD": "password-auth-not-used",
        "CORS_ORIGIN": "https://remember.example.com"
      },
      "secrets": {
        "required": ["OPENROUTER_API_KEY", "LOGIN_EMAIL", "LOGIN_PASSWORD_HASH", "SESSION_SECRET"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remember-db-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "remember-media-production"
        }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        {
          "binding": "VECTOR_INDEX",
          "index_name": "remember-imprints-production"
        }
      ],
      "workflows": [
        {
          "binding": "INGESTION_WORKFLOW",
          "name": "remember-ingestion-production",
          "class_name": "IngestionWorkflow"
        }
      ]
    }
  }
}
