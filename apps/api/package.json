{
  "name": "@remember/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "dev": "wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply remember-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply remember-db --remote",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "types": "wrangler types",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@remember/domain": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
