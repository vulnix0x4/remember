{
  "name": "@remember/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:production": "sh scripts/deploy-production.sh",
    "build": "wrangler deploy --dry-run --env= --outdir dist",
    "dev": "wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply remember-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply remember-db --remote",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "types": "wrangler types",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@remember/domain": "workspace:*",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
