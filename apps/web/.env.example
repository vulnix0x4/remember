# Optional Worker origin. Local origins automatically receive a fixed development user UUID.
VITE_API_BASE=http://127.0.0.1:8787
VITE_AUTH_MODE=token

# Production uses VITE_AUTH_MODE=password with an HttpOnly Worker session cookie.

# Optional local or private-preview verification only. This value is embedded in the browser bundle.
# Prefer entering a remote preview token in Settings so it stays in this browser's localStorage.
# Never use a shared production secret here.
VITE_API_TOKEN=
