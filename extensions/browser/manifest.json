{
  "manifest_version": 3,
  "name": "Remember",
  "description": "Save what shapes you.",
  "version": "1.0.0",
  "action": {
    "default_title": "Save to Remember",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "tabs", "contextMenus"],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://*.workers.dev/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the current page to Remember"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
